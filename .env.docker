# ══════════════════════════════════════════════════════════════════════
#  BalanceCycle — Environment Variables for Docker
#
#  1. Copy this file:   cp .env.docker .env
#  2. Fill in values    (at minimum change POSTGRES_PASSWORD)
#  3. Run:              docker compose up --build
# ══════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme          # ← CHANGE THIS
POSTGRES_DB=balancecycle

# ── Ollama LLM ──────────────────────────────────────────────────────
# Model to auto-pull on first boot (requires ~4 GB disk for llama3.1:8b)
OLLAMA_MODEL=llama3.1

# ── App ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS ────────────────────────────────────────────────────────────
# Your frontend origin — change to your domain in production
# e.g. https://balancecycle.yourdomain.com
ALLOWED_ORIGINS=http://localhost
